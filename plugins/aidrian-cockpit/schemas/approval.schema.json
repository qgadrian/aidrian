{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidrian.invalid/schemas/cockpit-approval-v1.json",
  "title": "Aidrian cockpit runtime approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectDigest",
    "configDigest",
    "capabilityManifestDigest",
    "pluginVersion",
    "pluginArtifactDigest",
    "moduleDigest",
    "controllerDigest",
    "hostVersion",
    "hostBinaryDigest",
    "declarationDigest",
    "approvedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectDigest": { "$ref": "#/$defs/digest" },
    "configDigest": { "$ref": "#/$defs/digest" },
    "capabilityManifestDigest": { "$ref": "#/$defs/digest" },
    "pluginVersion": { "$ref": "#/$defs/version" },
    "pluginArtifactDigest": { "$ref": "#/$defs/digest" },
    "moduleDigest": { "$ref": "#/$defs/digest" },
    "controllerDigest": { "$ref": "#/$defs/digest" },
    "hostVersion": { "$ref": "#/$defs/version" },
    "hostBinaryDigest": { "$ref": "#/$defs/digest" },
    "declarationDigest": { "$ref": "#/$defs/digest" },
    "approvedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    }
  }
}
