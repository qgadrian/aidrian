{
  "schemaVersion": 1,
  "id": "harness-engineer",
  "description": "Harness engineering specialist — owns standalone/architectural work on the AI-instruction system: token/cost optimization, agent-performance protection, deterministic-gate preference, context-doc architecture and tag routing, knowledge-doc health, model-specific prompt tuning from official Anthropic docs. Surfaces: docs/ai-rules/**, .agent/agents/**, .agents/skills/**, and the scripts matched by the `harness` pathRule.",
  "modelTier": "deep",
  "effort": "xhigh",
  "taskTags": [
    "always",
    "context_hygiene",
    "harness_engineering"
  ],
  "conditionalTags": [],
  "outputMode": "machine_handoff",
  "coverageExemption": null,
  "capabilities": {
    "allow": [
      "human.ask",
      "shell.execute",
      "fs.edit",
      "workspace.enter",
      "plan.exit",
      "agent.monitor",
      "fs.read",
      "review.report",
      "agent.message",
      "skill.invoke",
      "task.get",
      "task.list",
      "task.update",
      "tool.discover",
      "web.fetch",
      "fs.create",
      "connector.linear.all"
    ],
    "deny": []
  },
  "logicalConnectors": [
    "linear"
  ],
  "sandboxIntent": "host-default",
  "providerSupport": {
    "claude": "native",
    "codex": "instruction-only"
  },
  "providerRendering": {
    "claude": {
      "description": "plain",
      "taskTags": "flow-bare",
      "conditionalTags": "flow-bare",
      "tools": "flow-bare",
      "disallowedTools": "flow-bare",
      "emitTools": true,
      "emitDisallowedTools": false
    },
    "codex": {}
  },
  "reviewProfile": {
    "requiredReviewerIds": [],
    "awaitCodex": false
  },
  "instructions": "instructions.md",
  "projectSlots": [
    {
      "id": "project_bootstrap",
      "type": "markdown",
      "default": "Follow the consuming project's bootstrap, contract, handoff, and product-sensitivity rules.",
      "maxLength": 1200
    },
    {
      "id": "project_harness_name",
      "type": "text",
      "default": "consumer",
      "maxLength": 80
    },
    {
      "id": "project_name",
      "type": "text",
      "default": "the consuming project",
      "maxLength": 120
    },
    {
      "id": "project_product_rules",
      "type": "path",
      "default": "docs/product-rules.md",
      "maxLength": 240
    },
    {
      "id": "runtime_state_root",
      "type": "path",
      "default": ".agent",
      "maxLength": 120
    },
    {
      "id": "secondary_runtime_root",
      "type": "path",
      "default": ".agent-secondary",
      "maxLength": 120
    }
