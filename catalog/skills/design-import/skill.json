{
  "schemaVersion": 1,
  "id": "design-import",
  "projectSlots": [
    {
      "id": "design_system_name",
      "type": "text",
      "default": "the project design system",
      "maxLength": 120
    },
    {
      "id": "primary_provider_name",
      "type": "text",
      "default": "primary provider",
      "maxLength": 80
    },
    {
      "id": "project_name",
      "type": "text",
      "default": "the consuming project",
      "maxLength": 120
    },
    {
      "id": "repository_slug",
      "type": "text",
      "default": "owner/repository",
      "maxLength": 160
    },
    {
      "id": "runtime_state_root",
      "type": "path",
      "default": ".agent",
      "maxLength": 120
    }
  ],
  "source": {
    "origin": "consumer-baseline",
    "internalUse": "authorized-private",
    "publicEligibility": "unknown",
    "transformation": "genericized-template"
  }
}
