{
  "schemaVersion": 1,
  "id": "agent-issue-writer",
  "description": "Draft or create Linear-native implementation issues so AI agents get exact scope, repo context, dependencies, tracker metadata, and verification steps.",
  "modelTier": "standard",
  "effort": "medium",
  "taskTags": [
    "always",
    "context_hygiene",
    "issue_tracker",
    "testing"
  ],
  "conditionalTags": [],
  "outputMode": "machine_handoff",
  "coverageExemption": null,
  "capabilities": {
    "allow": [
      "agent.spawn",
      "human.ask",
      "shell.execute",
      "plan.exit",
      "fs.read",
      "agent.message",
      "skill.invoke",
      "task.create",
      "task.update",
      "tool.discover",
      "connector.linear.create.issue.label",
      "connector.linear.get.issue",
      "connector.linear.get.project",
      "connector.linear.get.team",
      "connector.linear.get.user",
      "connector.linear.list.issue.labels",
      "connector.linear.list.issue.statuses",
      "connector.linear.list.issues",
      "connector.linear.list.milestones",
      "connector.linear.list.projects",
      "connector.linear.list.teams",
      "connector.linear.save.comment",
      "connector.linear.save.issue",
      "connector.linear.save.milestone",
      "connector.linear.save.project"
    ],
    "deny": [
      "fs.mutate"
    ]
  },
  "logicalConnectors": [
    "linear"
  ],
  "sandboxIntent": "host-default",
  "providerSupport": {
    "claude": "native",
    "codex": "instruction-only"
  },
  "providerRendering": {
    "claude": {
      "description": "plain",
      "taskTags": "flow-bare",
      "conditionalTags": "flow-bare",
      "tools": "flow-bare",
      "disallowedTools": "flow-bare",
      "emitTools": true,
      "emitDisallowedTools": true
    },
    "codex": {}
  },
  "reviewProfile": {
    "requiredReviewerIds": [],
    "awaitCodex": false
  },
  "instructions": "instructions.md",
  "projectSlots": [
    {
      "id": "project_bootstrap",
      "type": "markdown",
      "default": "Follow the consuming project's bootstrap, contract, handoff, and product-sensitivity rules.",
      "maxLength": 1200
    },
    {
      "id": "project_harness_name",
      "type": "text",
      "default": "consumer",
      "maxLength": 80
    },
    {
      "id": "project_product_index",
      "type": "path",
      "default": "docs/product/index.md",
      "maxLength": 240
    },
    {
      "id": "project_product_rules",
      "type": "path",
      "default": "docs/product-rules.md",
      "maxLength": 240
    },
    {
      "id": "tracker_team_key",
      "type": "text",
      "default": "TEAM",
      "maxLength": 40
    }
  ],
  "providerFragments": [],
  "source": {
    "origin": "consumer-baseline",
    "internalUse": "authorized-private",
    "publicEligibility": "unknown",
    "transformation": "genericized-template"
  }
}
