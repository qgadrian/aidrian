{
  "schemaVersion": 1,
  "id": "doc-updater",
  "description": "project documentation maintenance specialist. Keeps README and docs/** aligned with repo and product truth via drift repair, doc-only tasks, and knowledge-* routing. Code-induced doc edits ride with the implementing slice, except docs/support/**, docs/product-knowledge/**, docs/product/** claims.",
  "modelTier": "standard",
  "effort": "medium",
  "taskTags": [
    "always",
    "context_hygiene",
    "skill_authoring"
  ],
  "conditionalTags": [],
  "outputMode": "machine_handoff",
  "coverageExemption": null,
  "capabilities": {
    "allow": [
      "human.ask",
      "shell.execute",
      "fs.edit",
      "workspace.enter",
      "plan.exit",
      "agent.monitor",
      "fs.read",
      "review.report",
      "agent.message",
      "skill.invoke",
      "task.get",
      "task.list",
      "task.stop",
      "task.update",
      "tool.discover",
      "fs.create",
      "connector.linear.get.issue",
      "connector.linear.get.user",
      "connector.linear.list.issues"
    ],
    "deny": []
  },
  "logicalConnectors": [
    "linear"
  ],
  "sandboxIntent": "host-default",
  "providerSupport": {
    "claude": "native",
    "codex": "instruction-only"
  },
  "providerRendering": {
    "claude": {
      "description": "plain",
      "taskTags": "flow-bare",
      "conditionalTags": "flow-bare",
      "tools": "flow-bare",
      "disallowedTools": "flow-bare",
      "emitTools": true,
      "emitDisallowedTools": false
    },
    "codex": {}
  },
  "reviewProfile": {
    "requiredReviewerIds": [],
    "awaitCodex": false
  },
  "instructions": "instructions.md",
  "projectSlots": [
    {
      "id": "project_bootstrap",
      "type": "markdown",
      "default": "Follow the consuming project's bootstrap, contract, handoff, and product-sensitivity rules.",
      "maxLength": 1200
    },
    {
      "id": "project_harness_name",
      "type": "text",
      "default": "consumer",
      "maxLength": 80
    },
    {
      "id": "project_name",
      "type": "text",
      "default": "the consuming project",
      "maxLength": 120
    },
    {
      "id": "project_product_rules",
      "type": "path",
      "default": "docs/product-rules.md",
      "maxLength": 240
    },
    {
      "id": "runtime_state_root",
      "type": "path",
      "default": ".agent",
      "maxLength": 120
    }
  ],
  "providerFragments": [],
  "source": {
    "origin": "consumer-baseline",
    "internalUse": "authorized-private",
    "publicEligibility": "unknown",
    "transformation": "genericized-template"
  }
}
