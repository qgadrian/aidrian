{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aidrian:knowledge-contract:folder:v1",
  "title": "Aidrian knowledge folder descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "owner",
    "visibility",
    "include",
    "exclude",
    "allowedLinkRoots",
    "routeSource",
    "orphanPolicy",
    "mayContributeAlwaysLoaded"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "enum": ["shared", "project-private"]
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))[^\\u0000]+$"
      }
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))[^\\u0000]+$"
      }
    },
    "allowedLinkRoots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))[^\\u0000*?\\[\\]{}]+$"
      }
    },
    "routeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "groupId"],
      "properties": {
        "format": {
          "const": "routed-inventory-v1"
        },
        "groupId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "orphanPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "forbid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "allow"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "paths"],
          "properties": {
            "mode": {
              "const": "allow-listed"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))[^\\u0000]+$"
              }
            }
          }
        }
      ]
    },
    "mayContributeAlwaysLoaded": {
      "type": "boolean"
    }
  }
}
