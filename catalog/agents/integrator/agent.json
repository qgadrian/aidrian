{
  "schemaVersion": 1,
  "id": "integrator",
  "description": "Land two or more cleanly-disjoint slice branches into a shared task branch through a scoped, single-writer serial sequence of rebases and fast-forward merges, routing the first conflict back to its owning specialist instead of resolving it.",
  "modelTier": "standard",
  "effort": "medium",
  "taskTags": [
    "always",
    "orchestration"
  ],
  "conditionalTags": [],
  "outputMode": "machine_handoff",
  "coverageExemption": "non-authoring-coordination",
  "capabilities": {
    "allow": [],
    "deny": [
      "fs.mutate"
    ]
  },
  "logicalConnectors": [],
  "sandboxIntent": "host-default",
  "providerSupport": {
    "claude": "native",
    "codex": "instruction-only"
  },
  "providerRendering": {
    "claude": {
      "description": "plain",
      "taskTags": "flow-bare",
      "conditionalTags": "flow-bare",
      "tools": "flow-bare",
      "disallowedTools": "flow-bare",
      "emitTools": false,
      "emitDisallowedTools": true
    },
    "codex": {}
  },
  "reviewProfile": {
    "requiredReviewerIds": [],
    "awaitCodex": false
  },
  "instructions": "instructions.md",
  "projectSlots": [
    {
      "id": "project_bootstrap",
      "type": "markdown",
      "default": "Follow the consuming project's bootstrap, contract, handoff, and product-sensitivity rules.",
      "maxLength": 1200
    },
    {
      "id": "project_harness_name",
      "type": "text",
      "default": "consumer",
      "maxLength": 80
    },
    {
      "id": "runtime_state_root",
      "type": "path",
      "default": ".agent",
      "maxLength": 120
    }
  ],
  "providerFragments": [],
  "source": {
    "origin": "consumer-baseline",
    "internalUse": "authorized-private",
    "publicEligibility": "unknown",
    "transformation": "genericized-template"
  }
}
