{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aidrian:knowledge-contract:index:v1",
  "title": "Aidrian project document catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["path", "abstract", "tags"],
    "properties": {
      "path": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))[^\\u0000]+$"
      },
      "abstract": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
