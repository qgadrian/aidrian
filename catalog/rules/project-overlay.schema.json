{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidrian.invalid/schemas/project-overlay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agentId", "fields", "slots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
        "modelTier": { "enum": ["fast", "standard", "deep", "orchestrator"] },
        "effort": { "enum": ["low", "medium", "high", "xhigh"] },
        "taskTags": { "$ref": "#/$defs/safeTags" },
        "conditionalTags": { "$ref": "#/$defs/safeTags" },
        "outputMode": { "enum": ["machine_handoff", "human_summary"] },
        "coverageExemption": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": { "$ref": "#/$defs/uniqueStrings" },
            "deny": { "$ref": "#/$defs/uniqueStrings" }
          }
        },
        "logicalConnectors": { "$ref": "#/$defs/uniqueStrings" },
        "sandboxIntent": { "enum": ["read-only", "workspace-write", "host-default"] },
        "providerSupport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude", "codex"],
          "properties": {
            "claude": { "$ref": "#/$defs/support" },
            "codex": { "$ref": "#/$defs/support" }
          }
        },
        "reviewProfile": { "$ref": "#/$defs/reviewProfile" }
      }
    },
    "slots": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000\\r]*$" }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "safeTags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "support": { "enum": ["native", "instruction-only", "unsupported"] },
    "reviewProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredReviewerIds", "awaitCodex"],
      "properties": {
        "requiredReviewerIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["claude", "codex"] }
        },
        "awaitCodex": { "type": "boolean" }
      }
    }
  }
}
