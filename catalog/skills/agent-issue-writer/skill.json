{
  "schemaVersion": 1,
  "id": "agent-issue-writer",
  "projectSlots": [
    {
      "id": "project_name_lower",
      "type": "text",
      "default": "project",
      "maxLength": 120
    },
    {
      "id": "runtime_state_root",
      "type": "path",
      "default": ".agent",
      "maxLength": 120
    },
    {
      "id": "tracker_team_id",
      "type": "text",
      "default": "configured-team-id",
      "maxLength": 120
    },
    {
      "id": "tracker_team_key",
      "type": "text",
      "default": "TEAM",
      "maxLength": 40
    }
  ],
  "source": {
    "origin": "consumer-baseline",
    "internalUse": "authorized-private",
    "publicEligibility": "unknown",
    "transformation": "genericized-template"
  }
}
