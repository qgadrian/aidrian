{
  "schemaVersion": 1,
  "id": "planning-agent",
  "description": "Create or revise decision-complete local planning artifacts under .agent/plans for implementation, rollout, or later GitHub publication.",
  "modelTier": "orchestrator",
  "effort": "high",
  "taskTags": [
    "always",
    "context_hygiene",
    "orchestration"
  ],
  "conditionalTags": [],
  "outputMode": "machine_handoff",
  "coverageExemption": null,
  "capabilities": {
    "allow": [
      "agent.spawn",
      "human.ask",
      "shell.execute",
      "fs.edit",
      "plan.exit",
      "fs.read",
      "agent.message",
      "skill.invoke",
      "task.update",
      "tool.discover",
      "web.fetch",
      "fs.create",
      "connector.linear.get.issue"
    ],
    "deny": []
  },
  "logicalConnectors": [
    "linear"
  ],
  "sandboxIntent": "host-default",
  "providerSupport": {
    "claude": "native",
    "codex": "instruction-only"
  },
  "providerRendering": {
    "claude": {
      "description": "plain",
      "taskTags": "flow-bare",
      "conditionalTags": "flow-bare",
      "tools": "flow-bare",
      "disallowedTools": "flow-bare",
      "emitTools": true,
      "emitDisallowedTools": false
    },
    "codex": {}
  },
  "reviewProfile": {
    "requiredReviewerIds": [],
    "awaitCodex": false
  },
  "instructions": "instructions.md",
  "projectSlots": [
    {
      "id": "design_import_root",
      "type": "path",
      "default": "docs/design-imports",
      "maxLength": 240
    },
    {
      "id": "project_bootstrap",
      "type": "markdown",
      "default": "Follow the consuming project's bootstrap, contract, handoff, and product-sensitivity rules.",
      "maxLength": 1200
    },
    {
      "id": "project_harness_name",
      "type": "text",
      "default": "consumer",
      "maxLength": 80
    },
    {
      "id": "runtime_state_root",
      "type": "path",
      "default": ".agent",
      "maxLength": 120
    }
  ],
  "providerFragments": [],
  "source": {
    "origin": "consumer-baseline",
    "internalUse": "authorized-private",
    "publicEligibility": "unknown",
    "transformation": "genericized-template"
  }
}
