{
  "schemaVersion": 1,
  "id": "explorer",
  "description": "Read-heavy exploration agent that maps repository flows, source-of-truth modules, tests, and edge cases without making changes.",
  "modelTier": "standard",
  "effort": "medium",
  "taskTags": ["always", "context_hygiene"],
  "conditionalTags": [],
  "outputMode": "machine_handoff",
  "coverageExemption": "non-authoring-coordination",
  "capabilities": {
    "allow": ["plan.exit", "fs.glob", "text.search", "code.symbols", "fs.read", "tool.discover"],
    "deny": ["fs.write", "shell.execute"]
  },
  "logicalConnectors": [],
  "sandboxIntent": "read-only",
  "providerSupport": {
    "claude": "native",
    "codex": "instruction-only"
  },
  "providerRendering": {
    "claude": {
      "description": "quoted",
      "taskTags": "flow-bare",
      "conditionalTags": "flow-bare",
      "tools": "flow-bare",
      "disallowedTools": "flow-bare",
      "emitTools": true,
      "emitDisallowedTools": true
    },
    "codex": {}
  },
  "reviewProfile": {
    "requiredReviewerIds": [],
    "awaitCodex": false
  },
  "instructions": "instructions.md",
  "projectSlots": [
    {
      "id": "context_map_path",
      "type": "path",
      "default": "docs/context-map.json",
      "maxLength": 240
    },
    {
      "id": "docs_glob",
      "type": "path",
      "default": "docs/**/*.md",
      "maxLength": 240
    },
    {
      "id": "symbol_project_kind",
      "type": "text",
      "default": "project",
      "maxLength": 120
    },
    {
      "id": "project_bootstrap",
      "type": "markdown",
      "default": "Follow the consuming project's bootstrap, contract, handoff, and product-sensitivity rules.",
      "maxLength": 1200
    },
    {
      "id": "project_invariant_bullets",
      "type": "markdown",
      "default": "   - domain invariants\n   - time and date handling\n   - user-facing parity rules\n   - localization and caching conventions",
      "maxLength": 1200
    },
    {
      "id": "project_edge_case_bullets",
      "type": "markdown",
      "default": "   - status transitions\n   - domain-specific forks\n   - side-effect triggers\n   - user-surface differences",
      "maxLength": 1200
    },
    {
      "id": "handoff_path",
      "type": "path",
      "default": "docs/handoffs.md",
      "maxLength": 240
    },
    {
      "id": "project_repository_rules",
      "type": "markdown",
      "default": "Repository rules (must respect):\n\n- Cite the consuming project's invariants rather than restating them.",
      "maxLength": 1600
    },
    {
      "id": "project_technical_rules",
      "type": "markdown",
      "default": "Technical conventions are supplied by the consuming project and must be loaded before asserting a convention.",
      "maxLength": 1600
    },
    {
      "id": "project_harness_name",
      "type": "text",
      "default": "consumer",
      "maxLength": 80
    }
  ],
  "providerFragments": [
    {
      "id": "symbol_warmup",
      "claude": "fragments/claude-symbol-warmup.md",
      "codex": null
    }
  ],
  "source": {
    "origin": "consumer-baseline",
    "internalUse": "authorized-private",
    "publicEligibility": "unknown",
    "transformation": "genericized-template"
  }
}
