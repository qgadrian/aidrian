{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidrian.invalid/schemas/agent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "description",
    "modelTier",
    "effort",
    "taskTags",
    "conditionalTags",
    "outputMode",
    "coverageExemption",
    "capabilities",
    "logicalConnectors",
    "sandboxIntent",
    "providerSupport",
    "providerRendering",
    "reviewProfile",
    "instructions",
    "projectSlots",
    "providerFragments",
    "source"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
    "modelTier": { "enum": ["fast", "standard", "deep", "orchestrator"] },
    "effort": { "enum": ["low", "medium", "high", "xhigh"] },
    "taskTags": { "$ref": "#/$defs/safeTags" },
    "conditionalTags": { "$ref": "#/$defs/safeTags" },
    "outputMode": { "enum": ["machine_handoff", "human_summary"] },
    "coverageExemption": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "$ref": "#/$defs/uniqueStrings" },
        "deny": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "logicalConnectors": { "$ref": "#/$defs/uniqueStrings" },
    "sandboxIntent": { "enum": ["read-only", "workspace-write", "host-default"] },
    "providerSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": { "$ref": "#/$defs/support" },
        "codex": { "$ref": "#/$defs/support" }
      }
    },
    "providerRendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "taskTags", "conditionalTags", "tools", "disallowedTools", "emitTools", "emitDisallowedTools"],
          "properties": {
            "description": { "enum": ["plain", "quoted"] },
            "taskTags": { "const": "flow-bare" },
            "conditionalTags": { "const": "flow-bare" },
            "tools": { "enum": ["flow-bare", "csv"] },
            "disallowedTools": { "const": "flow-bare" },
            "emitTools": { "type": "boolean" },
            "emitDisallowedTools": { "type": "boolean" }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "reviewProfile": { "$ref": "#/$defs/reviewProfile" },
    "instructions": { "const": "instructions.md" },
    "projectSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "default", "maxLength"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["markdown", "path", "text"] },
          "default": { "type": "string" },
          "maxLength": { "type": "integer", "minimum": 1, "maximum": 4096 }
        }
      }
    },
    "providerFragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claude", "codex"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "claude": { "type": ["string", "null"] },
          "codex": { "type": ["string", "null"] }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "internalUse", "publicEligibility", "transformation"],
      "properties": {
        "origin": { "const": "consumer-baseline" },
        "internalUse": { "const": "authorized-private" },
        "publicEligibility": { "const": "unknown" },
        "transformation": { "const": "genericized-template" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "safeTags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "support": { "enum": ["native", "instruction-only", "unsupported"] },
    "reviewProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredReviewerIds", "awaitCodex"],
      "properties": {
        "requiredReviewerIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["claude", "codex"] }
        },
        "awaitCodex": { "type": "boolean" }
      }
    }
  }
}
