{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidrian.invalid/schemas/cockpit-config-v1.json",
  "title": "Aidrian cockpit project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(?!-)(?!\\.{1,2}/)[A-Za-z0-9_.-]{1,100}/(?!-)(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,100}$"
        }
      }
    },
    "linear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "teamKeys"],
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^(?!-)[A-Za-z0-9._-]{1,128}$"
        },
        "teamKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,11}$"
          }
        }
      }
    }
  }
}
